{
  "name": "ui",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "storybook dev -p 6006",
    "build": "nx run-many -t build",
    "lint": "eslint .storybook config && nx run-many -t lint",
    "types": "tsc --noEmit && nx run-many -t types",
    "test": "nx run-many -t test",
    "test:coverage": "nx run-many -t test:coverage",
    "test:interaction": "nx run-many -t test:interaction",
    "test:storybook": "nx run-many -t test:storybook",
    "test:storybook:local": "node config/snapshot-tests.ts",
    "test:storybook:update": "node config/snapshot-tests.ts --update",
    "storybook:build": "storybook build -o dist_storybook"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nx/eslint-plugin": "^23.2.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/builder-vite": "^10.6.0",
    "@storybook/icons": "^2.1.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "happy-dom": "^20.14.0",
    "nx": "^23.2.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.0",
    "storybook-addon-vis": "^3.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.40.0",
    "unplugin-dts": "^1.1.0",
    "vite": "^8.3.0",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^4.1.11"
  }
}
